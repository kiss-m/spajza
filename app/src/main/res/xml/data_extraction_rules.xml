<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup or device transfer: the catalog is rebuilt from the APK and household data lives
     in Firestore, so a restore would only bring back stale caches and sign-in state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
